{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "flowsery",
  "version": "1.3.1",
  "description": "Query web analytics from your AI agent: real-time visitors, traffic breakdowns, revenue, goals, visitor profiles and the issues Flowsery found in session recordings. Privacy-first, cookie-free.",
  "author": {
    "name": "Flowsery",
    "url": "https://flowsery.com"
  },
  "homepage": "https://flowsery.com/features/agents",
  "repository": "https://github.com/Flowsery/claude-plugin",
  "license": "MIT",
  "keywords": ["analytics", "web-analytics", "privacy", "cookie-free", "revenue-tracking", "mcp"],
  "extensions": {
    "com.nousresearch.hermes": {
      "servers": {
        "flowsery": {
          "trust": "untrusted"
        }
      }
    }
  }
}
